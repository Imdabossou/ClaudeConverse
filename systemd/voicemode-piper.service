[Unit]
Description=Piper TTS with OpenAI-compatible API for VoiceMode
After=network.target

[Service]
ExecStart=%h/.voicemode/services/piper/.venv/bin/python %h/.voicemode/services/piper/server.py
Environment=PIPER_DEFAULT_VOICE=@VOICE@
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
